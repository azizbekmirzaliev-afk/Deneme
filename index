<!DOCTYPE html>
<html lang="uz" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Kamolon Barista Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        kamolon: { 50: '#fdf8f6', 100: '#f2e8e5', 500: '#d97706', 600: '#b45309', 900: '#78350f', 950: '#451a03' }
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; user-select: none; -webkit-user-select: none; }
        .glass-panel { background: rgba(30, 27, 24, 0.85); backdrop-filter: blur(12px); }
        @keyframes pulse-slow { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.03); } }
        .animate-pulse-slow { animation: pulse-slow 3s ease-in-out infinite; }
    </style>
</head>
<body class="bg-stone-950 text-stone-100 min-h-screen flex items-center justify-center p-0 sm:p-4">
    <div id="app" class="w-full max-w-md sm:max-w-xl bg-stone-900 sm:rounded-3xl shadow-2xl border border-stone-800 overflow-hidden flex flex-col h-[100dvh] sm:h-[840px] relative">
        <!-- Header -->
        <header class="flex items-center justify-between px-5 py-4 border-b border-stone-800 bg-stone-900/90 z-10">
            <div class="flex items-center gap-2">
                <span class="text-2xl">☕</span>
                <span class="font-extrabold text-amber-500 tracking-wide text-lg">KAMOLON BAR</span>
            </div>
            <div id="header-stats" class="flex items-center gap-3 text-sm">
                <span id="stat-score" class="px-3 py-1 bg-amber-500/10 text-amber-400 rounded-full font-bold border border-amber-500/20">⭐ 0.0</span>
                <span id="stat-money" class="px-3 py-1 bg-emerald-500/10 text-emerald-400 rounded-full font-bold border border-emerald-500/20">💰 0 so'm</span>
            </div>
        </header>

        <!-- Main Screen Viewport -->
        <main id="main-view" class="flex-1 flex flex-col overflow-y-auto p-4 sm:p-6 justify-between relative">
            <!-- Dinamik ekran içeriği buraya yüklenecek -->
        </main>
    </div>

    <script>
        const INGREDIENTS = [
            { id: 'single_shot_espresso', name: 'Single shot espresso (10 gr)', cat: 'qahva_sut', color: '#4a2511', e: '☕' },
