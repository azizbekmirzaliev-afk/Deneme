            { id: 'muzli_choy_konsentrati', name: 'Muzli choy konsentrati', cat: 'choy_suv', color: '#ca8a04', e: '🫖' },

            { id: 'olma', name: 'Olma', cat: 'meva_kokat', color: '#84cc16', e: '🍎' },
            { id: 'limon', name: 'Limon (bo‘lak)', cat: 'meva_kokat', color: '#facc15', e: '🍋' },
            { id: 'apelsin', name: 'Apelsin', cat: 'meva_kokat', color: '#fb923c', e: '🍊' },
